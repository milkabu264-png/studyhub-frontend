server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # запросы к API уходят на backend (адрес задаётся переменной BACKEND_URL)
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # файлы сборки можно долго кешировать — у них в имени хэш
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # React Router: любой адрес (/notebook, /statistics…) отдаёт index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
